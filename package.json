{
  "name": "cypher-os-test-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Herramientas de desarrollo y pruebas de CYPHER://OS; no forman parte del juego offline.",
  "scripts": {
    "firmware:sync": "node tests/firmware-version.js",
    "firmware:install": "git config --local core.hooksPath .githooks",
    "test": "node tests/smoke.js",
    "test:regressions": "node tests/regressions.js",
    "test:harness": "node tests/harness.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:list": "playwright test --list",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
